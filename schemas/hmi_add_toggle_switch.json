{
  "name": "hmi_add_toggle_switch",
  "description": "Add or update a tag-bound toggle switch with separate off/on captions.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "screen_name": { "description": "Screen name.", "type": "string" },
      "name": { "description": "Toggle switch item name.", "type": "string" },
      "off_text": { "description": "Caption shown in the normal state.", "type": "string" },
      "on_text": { "description": "Caption shown in the alternate state.", "type": "string" },
      "left": { "description": "X position.", "type": "integer" },
      "top": { "description": "Y position.", "type": "integer" },
      "width": { "description": "Width.", "type": "integer" },
      "height": { "description": "Height.", "type": "integer" },
      "process_tag": { "description": "HMI tag bound to IsAlternateState.", "type": "string" },
      "target_name": { "description": "Target HMI software name (optional).", "type": "string" }
    },
    "required": [
      "screen_name",
      "name",
      "off_text",
      "on_text",
      "left",
      "top",
      "width",
      "height",
      "process_tag"
    ],
    "type": "object"
  }
}
