{
  "name": "hmi_add_button",
  "description": "Add or update a button on a screen with text, position, colors, pressed state tag, and OnClick/Tapped JavaScript script.",
  "parameters": {
    "type": "object",
    "properties": {
      "screen_name": {
        "type": "string",
        "description": "Screen name."
      },
      "name": {
        "type": "string",
        "description": "Button item name."
      },
      "text": {
        "type": "string",
        "description": "Button caption. Plain Unicode text (\u00E4, \u00F6, \u00E5, \u00B0); the server wraps and escapes it as HTML, so do not use HTML entities."
      },
      "left": {
        "type": "integer",
        "description": "X position."
      },
      "top": {
        "type": "integer",
        "description": "Y position."
      },
      "width": {
        "type": "integer",
        "description": "Width."
      },
      "height": {
        "type": "integer",
        "description": "Height."
      },
      "back_color": {
        "type": "string",
        "description": "Background color."
      },
      "fore_color": {
        "type": "string",
        "description": "Text color."
      },
      "pressed_tag": {
        "type": "string",
        "description": "HMI tag to bind to button pressed state (optional)."
      },
      "tapped_script": {
        "type": "string",
        "description": "JavaScript code to execute on button tap (e.g. Tags.SysFct.InvertBitInTag(\u0022tag\u0022, 0);)."
      },
      "target_name": {
        "type": "string",
        "description": "Target HMI software name (optional)."
      }
    },
    "required": [
      "screen_name",
      "name",
      "text",
      "left",
      "top",
      "width",
      "height"
    ],
    "additionalProperties": false
  }
}