<schema targetNamespace="http://www.w3.org/2000/svg" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:svg="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" elementFormDefault="unqualified" attributeFormDefault="unqualified" xml:lang="en"
  xmlns:hmi-element="http://svg.siemens.com/hmi/element/"
  xmlns:hmi-bind="http://svg.siemens.com/hmi/bind/"
  xmlns:hmi-event="http://svg.siemens.com/hmi/event/"
  xmlns:hmi-flex="http://svg.siemens.com/hmi/flex/"
  xmlns:xml="http://www.w3.org/XML/1998/namespace"
  xmlns:hmi="http://svg.siemens.com/hmi/"
  xmlns:rtpu="http://svg.siemens.com/hmi/rtpu">
  <!-- don't declare the XML namespace; it is predeclared and redeclaring it upsets some software -->

  <import namespace="http://www.w3.org/1999/xlink" schemaLocation="xlink.xsd"/>
  <import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="xml.xsd"/>

  <import namespace="http://svg.siemens.com/hmi/flex/" schemaLocation="hmi-flex.xsd" />
  <import namespace="http://svg.siemens.com/hmi/event/"
    schemaLocation="hmi-event.xsd" />
  <import namespace="http://svg.siemens.com/hmi/"
    schemaLocation="hmi.xsd" />
  <import namespace="http://svg.siemens.com/hmi/bind/"
    schemaLocation="hmi-bind.xsd" />
  <import namespace="http://svg.siemens.com/hmi/element/"
    schemaLocation="hmi-element.xsd" />
  <import namespace="http://svg.siemens.com/hmi/types/"
  schemaLocation="hmi-types.xsd" />

  <!-- simpleTypes -->
  <simpleType name="BaselineShiftValueType">
    <annotation>
      <documentation>
        The actual definition is
        baseline | sub | super | &lt;percentage&gt; | &lt;length&gt; | inherit
        not sure that union can do this
      </documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <!-- SVG BooleanType not needed, already defined by XML Schema -->

  <simpleType name="ClipValueType">
    <annotation>
      <documentation>&lt;shape&gt; | auto | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="ClipPathValueType" rtpu:enabled="true" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String">
    <annotation>
      <documentation>&lt;uri&gt; | none | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="ClipFillRuleType">
    <annotation>
      <documentation>'clip-rule' or fill-rule property/attribute value</documentation>
    </annotation>
    <restriction base="string">
      <enumeration value="evenodd"/>
      <enumeration value="nonzero"/>
      <enumeration value="inherit"/>
    </restriction>
  </simpleType>
  <simpleType name="ContentTypeType">
    <annotation>
      <documentation source="http://www.ietf.org/rfc/rfc2045.txt">media type, as per [RFC2045]</documentation>
      <documentation>media type, as per [RFC2045]</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="CoordinateType" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation source="http://www.w3.org/TR/SVG/types.html#DataTypeCoordinate">a &lt;co-ordinate&gt;</documentation>
      <documentation>a coordinate, which is a number optionally followed immediately by a unit identifier. Perhaps it is possible to represent this as a union by declaring unit idenifiers as a type?</documentation>
    </annotation>
    <restriction base="string">
      <pattern value="((((\+|\-)?((\d+)))|((\+|\-)?(((((\d+)?\.(\d+))|((\d+)\.))([eE](\+|\-)?(\d+))?)|((\d+)([eE](\+|\-)?(\d+))))))(em|ex|px|pt|pc|cm|mm|in|%)?)"/>
    </restriction>
  </simpleType>
  <simpleType name="CoordinatesType">
    <annotation>
      <documentation>a space separated list of CoordinateType. Punt to 'string' for now</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="ColorType" rtpu:valueType="Color" rtpu:attributeClass="Color" rtpu:symbolType="String">
    <annotation>
      <documentation source="http://www.w3.org/TR/SVG/types.html#DataTypeColor">a CSS2 Color</documentation>
      <documentation>Color as defined in CSS2 and XSL 1.0 plus additional recognised color keyword names (the 'X11 colors')</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="CursorValueType">
    <annotation>
      <documentation>
        Value is an optional comma-separated list orf uri references followed by one token from an enumerated list.
      </documentation>
      <documentation>[ [&lt;uri&gt; ,]* [ auto | crosshair | default | pointer | move | e-resize | ne-resize | nw-resize | n-resize | se-resize | sw-resize | s-resize | w-resize| text | wait | help ] ] | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="EnableBackgroundValueType">
    <annotation>
      <documentation>accumulate | new [ &lt;x&gt; &lt;y&gt; &lt;width&gt; &lt;height&gt; ] | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="ExtensionListType">
    <annotation>
      <documentation>extension list specification</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="FeatureListType">
    <annotation>
      <documentation>feature list specification</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="FilterValueType" rtpu:enabled="true" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String">
    <annotation>
      <documentation>
        &lt;uri&gt; | none | inherit
      </documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="FontFamilyValueType" rtpu:valueType="String" rtpu:attributeClass="String" rtpu:symbolType="String">
    <annotation>
      <documentation>[[ &lt;family-name&gt; | &lt;generic-family&gt; ],]* [&lt;family-name&gt; | &lt;generic-family&gt;] | inherit</documentation>
      <documentation>'font-family' property/attribute value (i.e., list of fonts)</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="FontSizeValueType" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation>'font-size' property/attribute value</documentation>
      <documentation>&lt;absolute-size&gt; | &lt;relative-size&gt; | &lt;length&gt; | &lt;percentage&gt; | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="FontSizeAdjustValueType" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation>'font-size-adjust' property/attribute value</documentation>
      <documentation>&lt;number&gt; | none | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="AngleType" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation>'angle' property/attribute value for angles</documentation>
      <documentation>&lt;number&gt; | none | inherit</documentation>
    </annotation>
    <restriction base="decimal"/>
  </simpleType>
  <simpleType name="AlignmentModeType" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation>Valid between -1 and 1</documentation>
    </annotation>
    <restriction base="decimal"/>
  </simpleType>

  <simpleType name="GlyphOrientationHorizontalValueType">
    <annotation>
      <documentation>'glyph-orientation-horizontal' property/attribute value (e.g., &lt;angle&gt;)</documentation>
      <documentation>&lt;angle&gt; | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="GlyphOrientationVerticalValueType">
    <annotation>
      <documentation>'glyph-orientation-vertical' property/attribute value (e.g., 'auto', &lt;angle&gt;)</documentation>
      <documentation>auto | &lt;angle&gt; | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
    <simpleType name="styleType">
    <annotation>
      <documentation>'style property/attribute value </documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <complexType name="imageType">
    <group ref="svg:descTitleMetadata" minOccurs="0"/>
    <attributeGroup ref="svg:stdAttrs"/>
    <attributeGroup ref="svg:xlinkRefAttrs"/>
    <attribute ref="xlink:href" use="optional" rtpu:enabled="true" rtpu:attributeClass="String" rtpu:attributeTypeId="xlinkHref_res" rtpu:valueType="String" rtpu:symbolType="String"/>
    <attributeGroup ref="svg:PresentationAttributes-Color"/>
    <attributeGroup ref="svg:langSpaceAttrs"/>
    <attribute name="externalResourcesRequired" type="boolean" use="optional"/>
    <attributeGroup ref="svg:PresentationAttributes-Graphics"/>
    <attributeGroup ref="svg:PresentationAttributes-Viewports"/>
    <attribute name="transform" type="svg:TransformListType" use="optional"/>
    <attribute name="x" type="svg:CoordinateType" use="optional"/>
    <attribute name="y" type="svg:CoordinateType" use="optional"/>
    <attribute name="width" type="svg:LengthType" use="required"/>
    <attribute name="height" type="svg:LengthType" use="required"/>
    <attribute name="preserveAspectRatio" rtpu:enabled="true" rtpu:attributeClass="StringToNumericComposition" rtpu:delimiter=" ">
      <simpleType>
        <restriction base="token">
          <enumeration value="none" />
          <enumeration value="xMinYMin" />
          <enumeration value="xMidYMin" />
          <enumeration value="xMaxYMin"/>
          <enumeration value="xMinYMid"/>
          <enumeration value="xMidYMid"/>
          <enumeration value="xMaxYMid"/>
          <enumeration value="xMinYMax"/>
          <enumeration value="xMidYMax"/>
          <enumeration value="xMaxYMax"/>
          <enumeration value="meet"/>
          <enumeration value="slice"/>
        </restriction>
      </simpleType>
    </attribute>
  </complexType>
  <!-- no need to declare IntegerType as XML Schema defines integers -->
  <simpleType name="KerningValue">
    <annotation>
      <documentation>'kerning' property/attribute value (e.g., auto | &lt;length&gt;)</documentation>
      <documentation>auto | &lt;length&gt; | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="LanguageCodeType">
    <annotation>
      <documentation>a language code, as per [RFC3066]</documentation>
      <documentation source="http://www.ietf.org/rfc/rfc3066.txt"/>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="LanguageCodesType">
    <annotation>
      <documentation>a comma-separated list of language codes, as per [RFC3066]</documentation>
      <documentation source="http://www.ietf.org/rfc/rfc3066.txt"/>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="LengthType" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:valueType="Numeric">
    <annotation>
      <documentation>a &lt;length&gt;</documentation>
    </annotation>
    <restriction base="string">
      <pattern value="((((\+|\-)?((\d+)))|((\+|\-)?(((((\d+)?\.(\d+))|((\d+)\.))([eE](\+|\-)?(\d+))?)|((\d+)([eE](\+|\-)?(\d+))))))(em|ex|px|pt|pc|cm|mm|in|%)?)"/>
    </restriction>
  </simpleType>
  <simpleType name="LengthsType">
    <annotation>
      <documentation>a list of &lt;length&gt;s</documentation>
    </annotation>
    <restriction base="string"/>
    <!-- make a regexp for this one -->
  </simpleType>
  <simpleType name="LinkTargetType">
    <annotation>
      <documentation>link to this target</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="MarkerValueType">
    <annotation>
      <documentation>'marker' property/attribute value (e.g., 'none', %URI;)</documentation>
    </annotation>
    <restriction base="string"/>
    <!-- need to check this one, its a shorthand value -->
  </simpleType>
  <simpleType name="MaskValueType">
    <annotation>
      <documentation>'mask' property/attribute value (e.g., 'none', %URI;)</documentation>
      <documentation>&lt;uri&gt; | none | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="MediaDescType">
    <annotation>
      <documentation>comma-separated list of media descriptors.</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <!-- no need to define NumberType as XML Schema has double -->

  <simpleType name="NumberOrPercentageType" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation>a &lt;number&gt; or a  &lt;percentage&gt;</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>

  <simpleType name="OpacityValueType" rtpu:attributeClass="Number" rtpu:valueType="Numeric" rtpu:symbolType="Number">
    <annotation>
      <documentation>opacity value (e.g., &lt;number&gt;)</documentation>
      <documentation>&lt;alphavalue&gt; | inherit</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="PaintType" rtpu:valueType="Paint" rtpu:attributeClass="Paint" rtpu:symbolType="String">
    <annotation>
      <documentation>a 'fill' or 'stroke' property/attribute value</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="PathDataType" rtpu:attributeClass="Path" rtpu:symbolType="Structure" rtpu:valueType="PathCollection">
    <annotation>
      <documentation>a path data specification</documentation>
      <documentation source="http://www.w3.org/TR/SVG/paths.html"/>
      <documentation>Yes, of course this was generated by a program!</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="PointsType" rtpu:attributeClass="Points" rtpu:symbolType="Structure" rtpu:valueType="PointCollection">
    <annotation>
      <documentation>a list of points</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>

  <simpleType name="SpacingValueType" rtpu:enabled="true" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation>'letter-spacing' or 'word-spacing' property/attribute value (e.g., normal | &lt;length&gt;)</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="NumericArrayValueType" rtpu:enabled="true" rtpu:attributeClass="NumericArray" rtpu:symbolType="Structure" rtpu:valueType="NumericCollection">
    <annotation>
      <documentation>'alignment, stroke-dasharray' property/attribute value (e.g., 'none', list of &lt;number&gt;s)</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="StrokeDashOffsetValueType" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation>'stroke-dashoffset' property/attribute value (e.g., 'none', &gt;length&gt;)</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="StrokeMiterLimitValueType" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation>'stroke-miterlimit' property/attribute value (e.g., &lt;number&gt;)</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <simpleType name="StrokeWidthValueType" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number">
    <annotation>
      <documentation>'stroke-width' property/attribute value (e.g., &lt;length&gt;)</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <!-- <simpleType name="StructuredTextType" base="string"/> expanded -->

  <simpleType name="SVGColorType" rtpu:valueType="Color" rtpu:attributeClass="Color" rtpu:symbolType="String">
    <annotation>
      <documentation>An SVG color value (sRGB plus optional ICC)</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <!-- <simpleType name="TextType" base="string"/> not necessary (string) -->
  <simpleType name="TextDecorationValueType">
    <annotation>
      <documentation>'text-decoration' property/attribute value (e.g., 'none', 'underline')</documentation>
    </annotation>
    <restriction base="string">
      <enumeration value="none"/>
      <enumeration value="underline"/>
      <enumeration value="overline"/>
      <enumeration value="line-through"/>
      <enumeration value="blink"/>
      <enumeration value="inherit"/>
    </restriction>
  </simpleType>
  <simpleType name="TransformListType" rtpu:attributeClass="Matrix" rtpu:symbolType="Matrix" rtpu:valueType="Matrix">
    <annotation>
      <documentation>Yes, of course this was generated by a program!</documentation>
      <documentation>list of transforms</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <!-- <simpleType name="URIType" base="string"/> not necessary (use AnyURI) -->
  <simpleType name="ViewBoxSpecType" rtpu:attributeClass="ViewBox" rtpu:symbolType="Structure" rtpu:valueType="ViewBox">
    <annotation>
      <documentation>'viewBox' attribute specification</documentation>
    </annotation>
    <restriction base="string"/>
  </simpleType>
  <attributeGroup name="stdAttrs">
    <annotation>
      <documentation>All elements have an ID</documentation>
    </annotation>
    <attribute name="id" type="ID" use="optional" rtpu:enabled="true" rtpu:valueType="UInt32" rtpu:attributeClass="Id" rtpu:symbolType="String" rtpu:attributeTypeId="id"/>
    <attribute name="style" type="svg:styleType" use="optional" rtpu:enabled="true" rtpu:attributeClass="String" rtpu:symbolType="String" rtpu:valueType="String" rtpu:attributeTypeId="style"/>
    <attribute ref="xml:base" use="optional " rtpu:enabled="false"/>
    <attribute ref="hmi:if" use="optional" rtpu:enabled="true" rtpu:valueType="Numeric" rtpu:attributeClass="HmiIf" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiIf"/>
    <attribute ref="hmi:focusArea" use="optional" rtpu:enabled="true" rtpu:valueType="UInt32" rtpu:attributeClass="StringToNumeric" rtpu:attributeTypeId="hmiFocusArea"/>
    <attributeGroup ref="hmi-bind:HmiBindAttributes"/>
    <attributeGroup ref="svg:EventTypeAttrs" />
  </attributeGroup>
  <attributeGroup name="langSpaceAttrs">
    <annotation>
      <documentation>Common attributes for elements that might contain character data content</documentation>
    </annotation>
    <attribute ref="xml:lang" use="optional" rtpu:enabled="false"/>
    <attribute ref="xml:space" use="optional" rtpu:enabled="false"/>
  </attributeGroup>
  <attributeGroup name="xlinkRefAttrs">
    <annotation>
      <documentation>For most uses of URI referencing: standard XLink attributes other than xlink:href</documentation>
    </annotation>
    <attribute ref="xlink:type" fixed="simple" rtpu:enabled="true" rtpu:attributeClass="String" rtpu:valueType="String"/>
    <attribute ref="xlink:role"/>
    <attribute ref="xlink:arcrole"/>
    <attribute ref="xlink:title"/>
    <attribute ref="xlink:show" default="other"/>
    <attribute ref="xlink:actuate"/>
  </attributeGroup>
  <attributeGroup name="xlinkRefAttrsEmbed">
    <annotation>
      <documentation>Standard XLink attributes for uses of URI referencing where xlink:show is 'embed'</documentation>
    </annotation>
    <attribute ref="xlink:type" fixed="simple" rtpu:enabled="true" rtpu:attributeClass="String" rtpu:valueType="String"/>
    <attribute ref="xlink:role"/>
    <attribute ref="xlink:arcrole"/>
    <attribute ref="xlink:title"/>
    <attribute ref="xlink:show"/>
    <attribute ref="xlink:actuate"/>
  </attributeGroup>
  <attributeGroup name="EventTypeAttrs">
    <annotation>
      <documentation>The following are the different types of event attributes supported by RTPU</documentation>
    </annotation>
    <attribute ref="hmi-event:up" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String" rtpu:attributeTypeId="hmiEventUp"/>
    <attribute ref="hmi-event:down" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String" rtpu:attributeTypeId="hmiEventDown"/>
    <attribute ref="hmi-event:tapped" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String" rtpu:attributeTypeId="hmiEventTapped"/>
    <attribute ref="hmi-event:pan" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String" rtpu:attributeTypeId="hmiEventPan"/>
    <attribute ref="hmi-event:contextTapped" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String" rtpu:attributeTypeId="hmiEventContextTapped"/>
    <attribute ref="hmi-event:mouseEnter" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String" rtpu:attributeTypeId="hmiEventMouseEnter"/>
    <attribute ref="hmi-event:mouseHover" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String" rtpu:attributeTypeId="hmiEventMouseHover"/>
    <attribute ref="hmi-event:mouseLeave" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String" rtpu:attributeTypeId="hmiEventMouseLeave"/>
    <attribute ref="hmi-event:wheel" rtpu:valueType="UInt64" rtpu:attributeClass="URL" rtpu:symbolType="String" rtpu:attributeTypeId="hmiEventWheel"/>
  </attributeGroup>

  <attributeGroup name="FlexAttrs">
    <annotation>
      <documentation>The following are all supported attributes that can be used within the namespace hmi-flex</documentation>
    </annotation>
    <attribute ref="hmi-flex:width" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexWidth"/>
    <attribute ref="hmi-flex:height" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexHeight"/>
    <attribute ref="hmi-flex:minWidth" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexMinWidth"/>
    <attribute ref="hmi-flex:minHeight" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexMinHeight"/>
    <attribute ref="hmi-flex:maxWidth" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexMaxWidth"/>
    <attribute ref="hmi-flex:maxHeight" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexMaxHeight"/>
    <attribute ref="hmi-flex:direction" rtpu:enabled="true" use="optional" rtpu:valueType="String" rtpu:attributeClass="String" rtpu:symbolType="String" rtpu:attributeTypeId="hmiFlexDirection"/>
    <attribute ref="hmi-flex:justifyContent" rtpu:enabled="true" use="optional" rtpu:valueType="String" rtpu:attributeClass="String" rtpu:symbolType="String" rtpu:attributeTypeId="hmiFlexJustifyContent"/>
    <attribute ref="hmi-flex:alignContent" rtpu:enabled="true" use="optional" rtpu:valueType="String" rtpu:attributeClass="String" rtpu:symbolType="String" rtpu:attributeTypeId="hmiFlexAlignContent"/>
    <attribute ref="hmi-flex:alignItems" rtpu:enabled="true" use="optional" rtpu:valueType="String" rtpu:attributeClass="String" rtpu:symbolType="String" rtpu:attributeTypeId="hmiFlexAlignItems"/>
    <attribute ref="hmi-flex:alignSelf" rtpu:enabled="true" use="optional" rtpu:valueType="String" rtpu:attributeClass="String" rtpu:symbolType="String" rtpu:attributeTypeId="hmiFlexAlignSelf"/>
    <attribute ref="hmi-flex:grow" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexGrow"/>
    <attribute ref="hmi-flex:wrap" rtpu:enabled="true" use="optional" rtpu:valueType="Boolean" rtpu:attributeClass="Boolean" rtpu:symbolType="Boolean" rtpu:attributeTypeId="hmiFlexWrap"/>
    <attribute ref="hmi-flex:margin" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexMargin"/>
    <attribute ref="hmi-flex:marginLeft" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexMarginLeft"/>
    <attribute ref="hmi-flex:marginRight" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexMarginRight"/>
    <attribute ref="hmi-flex:marginTop" rtpu:enabled="true" use="optional" rtpu:valueType="Numeric" rtpu:attributeClass="Number" rtpu:symbolType="Number" rtpu:attributeTypeId="hmiFlexMarginTop"/>
