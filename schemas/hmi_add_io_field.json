{
  "name": "hmi_add_io_field",
  "description": "Add or update an IO field on a screen bound to a process value tag.",
  "parameters": {
    "type": "object",
    "properties": {
      "screen_name": {
        "type": "string",
        "description": "Screen name."
      },
      "name": {
        "type": "string",
        "description": "IO Field item name."
      },
      "left": {
        "type": "integer",
        "description": "X position."
      },
      "top": {
        "type": "integer",
        "description": "Y position."
      },
      "width": {
        "type": "integer",
        "description": "Width."
      },
      "height": {
        "type": "integer",
        "description": "Height."
      },
      "mode": {
        "type": "string",
        "description": "\u0027Output\u0027 or \u0027InputOutput\u0027 (default: Output)."
      },
      "process_tag": {
        "type": "string",
        "description": "HMI tag to bind to ProcessValue."
      },
      "output_format": {
        "type": "string",
        "description": "Output format, e.g. \u0027{F1} \u00B0C\u0027 for one decimal and a unit (optional; omit to keep the current format). Plain Unicode text, not HTML; do not use HTML entities (numeric references such as \u0026#176; are decoded)."
      },
      "target_name": {
        "type": "string",
        "description": "Target HMI software name (optional)."
      }
    },
    "required": [
      "screen_name",
      "name",
      "left",
      "top",
      "width",
      "height"
    ],
    "additionalProperties": false
  }
}