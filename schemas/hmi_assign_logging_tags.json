{
  "name": "hmi_assign_logging_tags",
  "description": "Assign multiple HMI tags to a DataLog with logging mode and cycle.",
  "parameters": {
    "type": "object",
    "properties": {
      "log_name": {
        "type": "string",
        "description": "Target DataLog name."
      },
      "tag_names": {
        "type": "array",
        "description": "List of HMI tag names to log.",
        "items": {
          "type": "string",
          "description": ""
        }
      },
      "cycle": {
        "type": "string",
        "description": "Logging cycle (e.g. \u0027T1s\u0027, \u0027T500ms\u0027, default: \u0027T1s\u0027)."
      },
      "mode": {
        "type": "string",
        "description": "Logging mode (\u0027Cyclic\u0027, \u0027OnChange\u0027, \u0027OnDemand\u0027, default: \u0027Cyclic\u0027)."
      },
      "target_name": {
        "type": "string",
        "description": "Target HMI software name (optional)."
      }
    },
    "required": [
      "log_name",
      "tag_names"
    ],
    "additionalProperties": false
  }
}