{
  "name": "hmi_create_text_list",
  "description": "Create a new text list on a WinCC Unified device with specified entries and values/ranges.",
  "parameters": {
    "type": "object",
    "properties": {
      "list_name": {
        "type": "string",
        "description": "Name of the text list to create."
      },
      "entries": {
        "type": "array",
        "description": "List of text entries. Each entry: { value, from_value (optional), to_value (optional), text, multilingual_texts (optional dict of lang-\u003Etext) }.",
        "items": {
          "type": "object",
          "description": "",
          "properties": {
            "value": {
              "type": "integer",
              "description": ""
            },
            "from_value": {
              "type": "integer",
              "description": ""
            },
            "to_value": {
              "type": "integer",
              "description": ""
            },
            "text": {
              "type": "string",
              "description": ""
            },
            "multilingual_texts": {
              "type": "object",
              "description": "",
              "additionalProperties": {
                "type": "string",
                "description": ""
              }
            }
          }
        }
      },
      "device_name": {
        "type": "string",
        "description": "Target HMI device or software name (optional)."
      }
    },
    "required": [
      "list_name",
      "entries"
    ],
    "additionalProperties": false
  }
}